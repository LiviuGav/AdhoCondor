<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Culoare fundal -->
    <solid android:color="#342d91"/>

    <!-- Colțuri rotunjite -->
    <corners android:radius="15dp"/>

    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="@android:color/black"/>

    <!-- Padding intern -->
    <padding
        android:left="16dp"
        android:top="8dp"
        android:right="16dp"
        android:bottom="8dp"/>
</shape>
