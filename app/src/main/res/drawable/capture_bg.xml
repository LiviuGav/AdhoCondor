<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Starea apăsat -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFCCCC"
                android:endColor="#FF6666"
                android:angle="45"/>
            <stroke
                android:width="4dp"
                android:color="#FF0000"/>
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp"/>
        </shape>
    </item>

    <!-- Starea normală -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#EEEEEE"
                android:angle="45"/>
            <stroke
                android:width="4dp"
                android:color="#FF0000"/>
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp"/>
        </shape>
    </item>

</selector>
